# PostgreSQL connection string. Without this, the site runs in local browser demo mode.
DATABASE_URL=postgresql://user:password@localhost:5432/fintrack
# Required for Vercel Cron to post recurring transactions (01:00 UTC / 08:00 Jakarta).
CRON_SECRET=replace-with-a-long-random-string
# Public canonical URL for Google OAuth and password reset links.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key and verified sender address for password reset emails.
RESEND_API_KEY=
RESET_FROM_EMAIL=
